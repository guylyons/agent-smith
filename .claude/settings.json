    "Notification": [{ "hooks": [{ "type": "command", "command": "bun run \"$CLAUDE_PROJECT_DIR/hooks/status.ts\"" }]}],
    "Stop":         [{ "hooks": [{ "type": "command", "command": "bun run \"$CLAUDE_PROJECT_DIR/hooks/status.ts\"" }]}],
    "SessionEnd":   [{ "hooks": [{ "type": "command", "command": "bun run \"$CLAUDE_PROJECT_DIR/hooks/status.ts\"" }]}]
  }
