{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "bun run \"$CLAUDE_PROJECT_DIR/hooks/status.ts\"" }]}],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "bun run \"$CLAUDE_PROJECT_DIR/hooks/status.ts\"" }]}],
